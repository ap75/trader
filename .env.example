# testnet | demo | mainnet
BYBIT_ENV=testnet
BYBIT_API_KEY=
BYBIT_API_SECRET=
SETTLE_COIN=USDT
BASE_COINS=BTC,ETH,SOL

# Лимиты безопасности. MAX_QTY_<МОНЕТА> обязателен для каждой монеты из BASE_COINS: без него (или 0) бот не
# стартует, а CLI не отправляет открывающие ордера. На demo для бумажных книг/E2 — 0.5 у BTC; в боевом .env — малые
MAX_QTY_BTC=0.1
MAX_QTY_ETH=1
MAX_QTY_SOL=10
MAX_ORDER_PREMIUM_USDT=500

# Защита от опечаток: отказ, если худшая цена исполнения по стакану хуже mark больше чем на N%
MAX_SLIPPAGE_PCT=15
# Кнопка «Выставить» в сигнале: каждая нога — лимитный IOC, первая попытка по ask/bid, дальше шагами
# до mid ± N % (покупки — первыми); ask/bid хоть одной ноги за этим пределом — стратегия не открывается;
# не собралось — исполненное закрывается reduce-only. Цена попыток не дальше MAX_SLIPPAGE_PCT от mark
MULTILEG_STEPS=3
MULTILEG_SLIPPAGE_PCT=10
MULTILEG_STEP_DELAY_S=1
# Первая нога (если это покупка) сначала стоит PostOnly по mid столько секунд, остаток — IOC; 0 — выключено.
# Maker 0.02% против taker 0.03% (demo) — выигрыш по комиссии мал, смысл только в полуспреде
PASSIVE_FIRST_LEG_SECONDS=0
# Рыночный ордер запрещён, если спред (ask-bid)/mid больше N%
MAX_SPREAD_PCT=20

# Лимиты портфеля (0 = выключено; уменьшать позицию/дельту можно всегда; reduce-only не ограничивается)
# |позиция по одному символу| после ордера, с учётом открытых ордеров в ту же сторону
MAX_POSITION_BTC=0.2
MAX_POSITION_ETH=2
MAX_POSITION_SOL=20
# |суммарная дельта опционов по активу| после ордера, в единицах актива
MAX_NET_DELTA_BTC=0.5
MAX_NET_DELTA_ETH=5
MAX_NET_DELTA_SOL=50
# Премия открывающих ордеров за сутки UTC (исполнено + стоит в стакане), USDT
MAX_DAILY_PREMIUM_USDT=2000

# Telegram
TELEGRAM_BOT_TOKEN=
# Узнать id: напишите боту /id (в личке или в разрешённой группе).
# id новой группы: добавьте бота в группу — он запишет её id в лог (WARNING) и выйдет.
# Разрешённые группы (id отрицательные, через запятую). В остальных группах бот не отвечает и выходит.
TELEGRAM_ALLOWED_CHAT_IDS=
# Могут торговать (и смотреть)
TELEGRAM_TRADER_IDS=
# Могут только смотреть
TELEGRAM_VIEWER_IDS=
# Администраторы (владелец бота): всё, что трейдеру, плюс функции только для администратора — в личку
TELEGRAM_ADMIN_IDS=
# Автосигналы администраторам в личку (в группы не идут; без TELEGRAM_ADMIN_IDS не работают):
# сводка по всем активам раз в сутки, время UTC ЧЧ:ММ (off — без сводки)
AUTO_SIGNALS_DAILY_UTC=09:05
# сообщение о смене рекомендации по активу — не чаще раза в N часов (0 — не присылать)
AUTO_SIGNALS_CHANGE_HOURS=4
# Срочные администраторам в личку: нет доступа к бирже (ключ/права/IP/регион), сработал лимит риска (MAX_*, маржа),
# сделка не через бота, запуск/остановка (и «прошлая остановка нештатная»). Одно и то же — не чаще раза в N минут
ADMIN_ALERT_QUIET_MIN=30
# Разрешить просмотр всем участникам разрешённых групп (торговля — всё равно только трейдерам)
ALLOW_ALL_GROUP_MEMBERS_VIEW=false
# Баланс, позиции, ордера и греки — только в личке
SENSITIVE_COMMANDS_DM_ONLY=true

# Сборщик рыночных данных: срез каждые N минут в SQLite (делитель 60)
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_MIN=15
# DB_PATH=data/market-<BYBIT_ENV>.db  (по умолчанию — своя БД на окружение)

# Журнал сделок (ордера, исполнения, поставки) и журнал сигналов (/signals, итоги) — та же БД; сверка с биржей
# и итоги сигналов при старте и каждые N минут. false — оба журнала не пишутся
JOURNAL_ENABLED=true
JOURNAL_SYNC_MIN=60
# глубина первой выгрузки истории, дней
JOURNAL_BACKFILL_DAYS=30
# секрет хеша пользователя в orderLinkId (пусто - производный от BYBIT_API_SECRET; при смене ключа хеши новых ордеров меняются)
JOURNAL_SECRET=

# Сигналы (/signals, этап 3): неверное значение — по умолчанию с предупреждением в логе;
# в несогласованной паре (DTE_MIN/MAX, EMA, PCTL, DEBIT_*_DELTA, MIN_HISTORY/LOOKBACK) сбрасывается заданное здесь
# срок IV постоянной дюрации и окно экспирации, дни
SIG_TARGET_DAYS=7
SIG_DTE_MIN=2
SIG_DTE_MAX=7
# истории сборщика меньше N дней — «мало истории», решение только по IV/RV; окно истории для IV percentile
SIG_MIN_HISTORY_DAYS=14
SIG_LOOKBACK_DAYS=60
# IV высокая: pctl >= HIGH и IV7 > RV7 * IV_RV_HIGH;
# низкая: (pctl <= LOW и IV7 <= RV7 * IV_RV_HIGH) или (IV7 < RV7 и pctl < HIGH)
# (пока истории меньше SIG_MIN_HISTORY_DAYS — только IV/RV); MIN_HISTORY — не больше 80% от LOOKBACK
SIG_PCTL_HIGH=70
SIG_PCTL_LOW=30
SIG_IV_RV_HIGH=1.15
# тренд по 4h-свечам перпетуала: |EMA_FAST/EMA_SLOW - 1| >= TREND_PCT % и наклон медленной EMA в ту же сторону
SIG_EMA_FAST=12
SIG_EMA_SLOW=48
SIG_TREND_PCT=1.0
# |дельта| коротких ног кондора/кредит-спреда; ног дебет-спреда; ширина крыла — доля ожидаемого движения
SIG_SHORT_DELTA=0.20
SIG_DEBIT_LONG_DELTA=0.45
SIG_DEBIT_SHORT_DELTA=0.25
SIG_WING_EM=0.5
# ликвидность каждой ноги: спред <= N % от mid, открытый интерес * форвард >= N USDT
SIG_MAX_LEG_SPREAD_PCT=20
SIG_MIN_OI_USD=20000
# кредит >= доли ширины спреда; дебет <= доли ширины спреда
SIG_MIN_CREDIT_RATIO=0.10
SIG_MAX_DEBIT_RATIO=0.60

# --- Эксперимент E1: бумажные книги (optbot/paper.py), без ордеров ---
# длинный горизонт: окно экспирации и срок IV (IV30 против RV30); RV14/RV30 >= k — премию не продавать;
# pctl IV30 — только при истории >= IV_PCT_MIN_DAYS дн.
SIG_LONG_DTE_MIN=14
SIG_LONG_DTE_MAX=45
SIG_LONG_TARGET_DAYS=30
SIG_RV14_RV30_MAX=1.25
IV_PCT_MIN_DAYS=30
# календарь: ATM IV ближней / дальней >= k при боковом тренде; окно ближней ноги, дни
SIG_CALENDAR_INVERSION=1.10
SIG_CAL_NEAR_DTE_MIN=5
SIG_CAL_NEAR_DTE_MAX=14
# издержки круга «вход — выход» (комиссии + спред bid/ask) <= N % премии по mid: книги «:cost» не открывают
# дороже (рядом — те же книги без фильтра), в карточке /signals — предупреждение; 0 — без фильтра и без книг «:cost»
SIG_MAX_COST_PCT=15
PAPER_ENABLED=1
# PAPER_BASES=BTC,ETH,SOL       # пусто — BASE_COINS
# риск на сделку: кол-во = min(бюджет / риск на 1 лот, MAX_QTY_<A>, MAX_POSITION_<A>), вниз до шага лота
# (урезано лимитом — пометка в журнале; на demo MAX_QTY_BTC / MAX_POSITION_BTC подняты до 0.5 — ТОЛЬКО demo,
# в боевом .env оставить малые)
PAPER_RISK_USDT=100
PAPER_MAX_OPEN_PER_BOOK=5
PAPER_MAX_TOTAL_RISK_USDT=3000
# исполнение: хуже bid/ask на N%; комиссия min(RATE * индекс, CAP % премии) * кол-во
PAPER_SLIPPAGE_PCT=1
PAPER_FEE_RATE=0.0003
PAPER_FEE_CAP_PCT=7
# поставка: min(RATE * индекс, CAP % внутренней стоимости) * кол-во; по активу — PAPER_DELIVERY_FEE_RATE_<A>
# (по умолчанию 0.00015, у SOL 0.0002)
# PAPER_DELIVERY_FEE_RATE=0.00015
PAPER_DELIVERY_FEE_CAP_PCT=12.5
# выход: % макс. прибыли (у стрэддла — % риска); стоп — убыток % риска; за N дн. до экспирации (0 — держать)
PAPER_TAKE_PCT=50
PAPER_STOP_PCT=50
PAPER_EXIT_DAYS_SHORT=0
PAPER_EXIT_DAYS_LONG=7
# календарь: закрыть за N ч до ближней экспирации; цель — % дебета (а также стоп и уход цены за ожид. движение)
PAPER_CALENDAR_EXIT_H=18
PAPER_CALENDAR_TAKE_PCT=35
# IM обычного режима короткой ноги: mark + max(SHORT % * S - OTM, MIN % * S)
PAPER_IM_SHORT_PCT=10
PAPER_IM_MIN_PCT=5
# календарь событий высокой важности (тег event); относительный путь — от корня проекта
EVENTS_FILE=events.csv

# --- Резервная копия БД и внешний мониторинг ---
# копия через sqlite backup API (онлайн, без остановки бота) раз в сутки в ЧЧ:ММ UTC (off — нет); папка
# (относительная — от корня проекта); сколько дней хранить. Забирать на компьютер — deploy/README.md
BACKUP_DAILY_UTC=03:20
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
# healthchecks.io (или аналог): адрес проверки https://hc-ping.com/<uuid>; бот пингует после каждого среза
# сборщика (сбой среза — /fail). В сервисе: период 15 мин, grace 30 мин. Пусто — без мониторинга (предупреждение)
HEALTHCHECK_URL=
