# ~/.config/optbot-pull-backups.env — настройки выгрузки копий (не коммитить: адрес сервера)
OPTBOT_BACKUP_SERVER=ap@SERVER
OPTBOT_BACKUP_REMOTE=trader/backups
# папка backups/ рабочей копии проекта (в .gitignore) или любая другая
OPTBOT_BACKUP_DEST=/home/ap/Desktop/work/trader/backups
# отдельный ключ без пароля (таймер работает без агента ssh); пусто — ключи ssh по умолчанию
OPTBOT_BACKUP_SSH_KEY=/home/ap/.ssh/optbot_backup
# необязательно: отдельная проверка healthchecks.io (период 1 день, grace — сколько компьютер бывает выключен)
OPTBOT_BACKUP_HEALTHCHECK=
